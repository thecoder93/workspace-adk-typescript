{
  "name": "random-city-agent",
  "version": "0.0.0",
  "description": "A simple ADK agent that suggests a random city.",
  "scripts": {
    "start": "cd reflection && npx adk web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@google/adk": "^0.3.0",
    "@google/adk-devtools": "^0.3.0",
    "@types/node": "^25.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  }
}
